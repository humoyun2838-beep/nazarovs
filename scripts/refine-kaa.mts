import fs from 'node:fs';import Database from 'better-sqlite3';import {createHash} from 'node:crypto';import {requestTranslations} from '../src/lib/translation-api';import {translationKey,type TranslationRow} from '../src/lib/translation-format';
const db=new Database('runtime-data/nazarov.db');const key=String((db.prepare('SELECT value FROM app_settings WHERE key=?').get('openai_api_key') as {value:string}).value);const cache:Record<string,TranslationRow>=JSON.parse(fs.readFileSync('artifacts/i18n/ai-cache.json','utf8'));const donePath='artifacts/i18n/kaa-refined.json';const done:Set<string>=new Set(fs.existsSync(donePath)?JSON.parse(fs.readFileSync(donePath,'utf8')):[]);const ui=JSON.parse(fs.readFileSync('src/data/ui-translations.json','utf8')),catalog=JSON.parse(fs.readFileSync('src/data/catalog-translations.json','utf8'));const sources=[...new Set([...Object.keys(ui),...Object.keys(catalog)])].filter(s=>!done.has(s));const batches:string[][]=[];let batch:string[]=[],size=0;for(const s of sources){if(batch.length&&(size+s.length>1800||batch.length>=20)){batches.push(batch);batch=[];size=0;}batch.push(s);size+=s.length}if(batch.length)batches.push(batch);let cursor=0,count=0;const failures:string[]=[];const insert=db.prepare('INSERT INTO site_translations(source_hash,locale,text,updated_at) VALUES(?,\'kaa\',?,?) ON CONFLICT(source_hash,locale) DO UPDATE SET text=excluded.text,updated_at=excluded.updated_at');
function save(){fs.writeFileSync('src/data/ui-translations.json',JSON.stringify(ui));fs.writeFileSync('src/data/catalog-translations.json',JSON.stringify(catalog));fs.writeFileSync('artifacts/i18n/ai-cache.json',JSON.stringify(cache));fs.writeFileSync(donePath,JSON.stringify([...done]));}
console.log({sources:sources.length,batches:batches.length});await Promise.all(Array.from({length:6},async()=>{while(cursor<batches.length){const id=cursor++,texts=batches[id];let ok=false;for(let attempt=0;attempt<3;attempt++){try{const rows=await requestTranslations(key,texts,['kaa']);db.transaction(()=>{for(const row of rows){const s=texts[row.id],v=row.values.kaa!;if(ui[s])ui[s].kaa=v;if(catalog[s])catalog[s].kaa=v;cache[s]={...(cache[s]||ui[s]||catalog[s]),kaa:v};insert.run(createHash('sha256').update(translationKey(s)).digest('hex'),v,new Date().toISOString());done.add(s);}})();ok=true;break;}catch(e){console.log({batch:id,retry:attempt,error:e instanceof Error?e.message:'error'});}}if(!ok)failures.push(...texts);count+=texts.length;save();console.log({done:count,total:sources.length,failed:failures.length});}}));fs.writeFileSync('artifacts/i18n/kaa-refine-report.json',JSON.stringify({sources:sources.length,failures},null,2));db.close();if(failures.length)process.exitCode=1;
