import fs from 'node:fs';import Database from 'better-sqlite3';import {createHash} from 'node:crypto';import {requestTranslations} from '../src/lib/translation-api';import {translationKey} from '../src/lib/translation-format';
const db=new Database('runtime-data/nazarov.db');const key=String((db.prepare('SELECT value FROM app_settings WHERE key=?').get('openai_api_key') as {value:string}).value);const sources=[...new Set((JSON.parse(fs.readFileSync('artifacts/i18n/numeric-audit.json','utf8')) as Array<{source:string}>).map(r=>r.source))];const ui=JSON.parse(fs.readFileSync('src/data/ui-translations.json','utf8')),catalog=JSON.parse(fs.readFileSync('src/data/catalog-translations.json','utf8')),cache=JSON.parse(fs.readFileSync('artifacts/i18n/ai-cache.json','utf8'));for(const s of sources){const rows=await requestTranslations(key,[s],['uz','ru','en','kaa']);const value=rows[0].values;cache[s]=value;if(ui[s])ui[s]=value;if(catalog[s])catalog[s]=value;for(const [locale,text] of Object.entries(value))db.prepare('UPDATE site_translations SET text=? WHERE source_hash=? AND locale=?').run(text,createHash('sha256').update(translationKey(s)).digest('hex'),locale);}for(const [file,value]of [['src/data/ui-translations.json',ui],['src/data/catalog-translations.json',catalog],['artifacts/i18n/ai-cache.json',cache]] as const)fs.writeFileSync(file,JSON.stringify(value));db.close();console.log({repaired:sources.length});
