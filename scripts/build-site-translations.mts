import fs from 'node:fs';
import { createHash } from 'node:crypto';
import Database from 'better-sqlite3';
import { requestTranslations } from '../src/lib/translation-api';
import { translationKey, type TranslationRow } from '../src/lib/translation-format';
import type { Locale } from '../src/lib/locale';
const db=new Database('runtime-data/nazarov.db');const key=String((db.prepare('SELECT value FROM app_settings WHERE key=?').get('openai_api_key') as {value?:string})?.value||'').trim();if(!key)throw new Error('API key required');
const locales:Locale[]=['uz','ru','en','kaa'];const cachePath='artifacts/i18n/ai-cache.json';const cache:Record<string,TranslationRow>=fs.existsSync(cachePath)?JSON.parse(fs.readFileSync(cachePath,'utf8')):{};Object.assign(cache,JSON.parse(fs.readFileSync('artifacts/i18n/bootstrap-ui.json','utf8')));
const source={ui:JSON.parse(fs.readFileSync('artifacts/i18n/ui-source.json','utf8')) as string[],catalog:JSON.parse(fs.readFileSync('artifacts/i18n/catalog-source.json','utf8')) as string[]};
db.exec('CREATE TABLE IF NOT EXISTS site_translations(source_hash TEXT NOT NULL,locale TEXT NOT NULL,text TEXT NOT NULL,updated_at TEXT NOT NULL,PRIMARY KEY(source_hash,locale))');const insert=db.prepare('INSERT INTO site_translations(source_hash,locale,text,updated_at) VALUES(?,?,?,?) ON CONFLICT(source_hash,locale) DO UPDATE SET text=excluded.text,updated_at=excluded.updated_at');
const all=[...new Set([...source.ui,...source.catalog])].filter(s=>!cache[translationKey(s)]);const batches:string[][]=[];let batch:string[]=[];let size=0;for(const s of all){if(size+s.length>1000||batch.length>=1){batches.push(batch);batch=[];size=0}batch.push(s);size+=s.length}if(batch.length)batches.push(batch);
let cursor=0,done=0;const failures:string[]=[];console.log(JSON.stringify({missing:all.length,batches:batches.length}));
function save(){fs.writeFileSync(cachePath,JSON.stringify(cache));for(const name of ['ui','catalog'] as const){const out:Record<string,TranslationRow>={};for(const s of source[name])if(cache[translationKey(s)])out[translationKey(s)]=cache[translationKey(s)];fs.writeFileSync(`src/data/${name}-translations.json`,JSON.stringify(out));}}
await Promise.all(Array.from({length:6},async()=>{while(cursor<batches.length){const index=cursor++,lines=batches[index];let ok=false;for(let attempt=0;attempt<4;attempt++){try{const rows=await requestTranslations(key,lines,locales);for(const row of rows){const text=translationKey(lines[row.id]);cache[text]=row.values as TranslationRow;}db.transaction(()=>{for(const s of lines)for(const locale of locales)insert.run(createHash('sha256').update(translationKey(s)).digest('hex'),locale,cache[translationKey(s)][locale],new Date().toISOString())})();ok=true;break;}catch(e){console.log(JSON.stringify({batch:index,retry:attempt+1,error:e instanceof Error?e.message:'error'}));await new Promise(r=>setTimeout(r,2000*(attempt+1)));}}if(!ok)failures.push(...lines);done+=lines.length;save();console.log(JSON.stringify({done,total:all.length,failed:failures.length}));}}));save();db.close();fs.writeFileSync('artifacts/i18n/generation-report.json',JSON.stringify({total:all.length,failures},null,2));if(failures.length)process.exitCode=1;
